/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML: siempre fresco (referencia al CSS/JS y a los assets)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS y JS: revalidar siempre. Si no cambió, el server responde 304
# (solo headers, casi cero bandwidth) y el navegador usa su copia.
# Así nunca queda CSS viejo congelado, sin gastar bandwidth de más.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Imágenes: caché corto (1 hora). Bajan una vez y se reusan,
# pero si actualizamos un render, en máximo 1 hora todos ven el nuevo.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# Fuentes: nunca cambian => caché de 1 año (gran ahorro de bandwidth
# en visitas repetidas)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
